# ════════════════════════════════════════════════════════════════
# MEETMIND AI — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ════════════════════════════════════════════════════════════════
# SECURITY NOTICE:
# - NEVER commit real API keys or credentials to this file or Git.
# - Copy this file to '.env' and fill in your actual credentials.
# - Real secrets belong ONLY in your local, untracked '.env' file.
# ════════════════════════════════════════════════════════════════

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/meetmind_db

# ── Provider Key Rotation Architecture ─────────────────────────
# - Numbered slots support multi-key rotation per provider.
# - Blank/unset numbered slots are ignored by the loader.
# - Keys do NOT need to be contiguous (e.g. slots 1, 3, 7 can be set).
# - Multiple configured keys are rotated using the internal provider key pool.
# - Health-aware selection, exponential cooldown, and rate-limit handling are
#   managed entirely inside the Provider Infrastructure.
# - Agents and tools must NEVER access or select raw API keys directly.

# ── Google Gemini (Required — At least 1 active key) ───────────
# Supports up to 20 numbered keys for round-robin rotation.
# Accepts GOOGLE_API_KEY_N or GEMINI_API_KEY_N (case-insensitive aliases).
# Legacy fallback: GOOGLE_API_KEY is used ONLY if no numbered keys are set.
GOOGLE_API_KEY_1=your_google_api_key_1_here
GOOGLE_API_KEY_2=your_google_api_key_2_here
GOOGLE_API_KEY_3=your_google_api_key_3_here
GOOGLE_API_KEY_4=your_google_api_key_4_here
GOOGLE_API_KEY_5=your_google_api_key_5_here
GOOGLE_API_KEY_6=your_google_api_key_6_here
GOOGLE_API_KEY_7=your_google_api_key_7_here
GOOGLE_API_KEY_8=your_google_api_key_8_here
GOOGLE_API_KEY_9=your_google_api_key_9_here
GOOGLE_API_KEY_10=your_google_api_key_10_here
GOOGLE_API_KEY_11=your_google_api_key_11_here
GOOGLE_API_KEY_12=your_google_api_key_12_here
GOOGLE_API_KEY_13=your_google_api_key_13_here
GOOGLE_API_KEY_14=your_google_api_key_14_here
GOOGLE_API_KEY_15=your_google_api_key_15_here
GOOGLE_API_KEY_16=your_google_api_key_16_here
GOOGLE_API_KEY_17=your_google_api_key_17_here
GOOGLE_API_KEY_18=your_google_api_key_18_here
GOOGLE_API_KEY_19=your_google_api_key_19_here
GOOGLE_API_KEY_20=your_google_api_key_20_here

# Legacy fallback (single key; ignored if any GOOGLE_API_KEY_1..20 is defined)
GOOGLE_API_KEY=your_google_api_key_legacy_fallback_here

# ── OpenRouter (Optional — Fallback / Backup Provider) ─────────
# Supports up to 5 numbered keys for rotation across free/backup models.
# Unset/blank slots are ignored.
# Legacy fallback: OPENROUTER_API_KEY is used ONLY if no numbered keys are set.
OPENROUTER_API_KEY_1=your_openrouter_api_key_1_here
OPENROUTER_API_KEY_2=your_openrouter_api_key_2_here
OPENROUTER_API_KEY_3=your_openrouter_api_key_3_here
OPENROUTER_API_KEY_4=your_openrouter_api_key_4_here
OPENROUTER_API_KEY_5=your_openrouter_api_key_5_here

# Legacy fallback (single key; ignored if any OPENROUTER_API_KEY_1..5 is defined)
OPENROUTER_API_KEY=your_openrouter_api_key_legacy_fallback_here

# ── Tavily (Optional — External Search Provider) ───────────────
# Supports up to 5 numbered keys for rotation.
# Unset/blank slots are ignored.
# Legacy fallback: TAVILY_API_KEY is used ONLY if no numbered keys are set.
TAVILY_API_KEY_1=your_tavily_api_key_1_here
TAVILY_API_KEY_2=your_tavily_api_key_2_here
TAVILY_API_KEY_3=your_tavily_api_key_3_here
TAVILY_API_KEY_4=your_tavily_api_key_4_here
TAVILY_API_KEY_5=your_tavily_api_key_5_here

# Legacy fallback (single key; ignored if any TAVILY_API_KEY_1..5 is defined)
TAVILY_API_KEY=your_tavily_api_key_legacy_fallback_here

# ── Pinecone Vector Database ───────────────────────────────────
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=hackathon-index

# ── Resend Email Service ───────────────────────────────────────
RESEND_API_KEY=your_resend_api_key_here
RESEND_SENDER=onboarding@resend.dev

# ── Notification Scheduler ─────────────────────────────────────
NOTIFICATION_HOUR=8
NOTIFICATION_MINUTE=0

# ── Application Environment ────────────────────────────────────
APP_ENV=development
DEBUG=true